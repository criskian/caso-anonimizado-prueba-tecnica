# Copia este archivo como .env y cambia la contraseña.
# .env está en .gitignore: nunca se sube al repositorio.

# Contraseña del usuario sa de SQL Server (solo para desarrollo local).
# Debe tener al menos 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_2026!

# Puerto del host donde se publica SQL Server. Se usa 14330 para no chocar
# con una instancia local que ya use el 1433.
MSSQL_PORT=14330
